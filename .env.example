# Public base URL used for canonical links, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://anilumi.in
# Google Search Console HTML-tag verification token (content attribute only)
NEXT_PUBLIC_GSC_VERIFICATION=
# Set to 1 to render ad slots
NEXT_PUBLIC_ADS=
# Set to 1 to fill in next-episode numbers for long-running shows from MyAnimeList (Jikan).
# Needs outbound access to api.jikan.moe; leave unset if that host is blocked.
JIKAN_ENRICH=
# Affiliate (optional). Amazon Associates tag, and an optional wrapper prefix for streaming links (Skimlinks/Impact style).
NEXT_PUBLIC_AMAZON_TAG=
NEXT_PUBLIC_AFFILIATE_WRAP=
